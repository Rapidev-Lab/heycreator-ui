#!/bin/sh

# Git Flow: Enforce branch naming and prevent direct pushes to development

current_branch=$(git rev-parse --abbrev-ref HEAD)
remote_name="$1"
remote_url="$2"

# Check if pushing to development branch
if echo "$current_branch" | grep -q "^dev$\|^development$"; then
    echo ""
    echo "ERROR: Direct pushes to development branch are not allowed"
    echo ""
    echo "Current branch: $current_branch"
    echo ""
    echo "Please use pull requests to merge changes into development."
    echo "If you are an admin and need to bypass this restriction, use:"
    echo "  git push --no-verify"
    echo ""
    exit 1
fi

# Validate branch naming convention
if ! echo "$current_branch" | grep -qE "^(feature|bugfix|release|hotfix)/.+$|^(main|master|dev|development)$"; then
    echo ""
    echo "ERROR: Branch name does not follow Git Flow conventions"
    echo ""
    echo "Current branch: $current_branch"
    echo ""
    echo "Required branch naming patterns:"
    echo "  feature/<name>   - for new features"
    echo "  bugfix/<name>    - for bug fixes"
    echo "  release/<version> - for releases"
    echo "  hotfix/<name>    - for urgent fixes"
    echo ""
    echo "Examples:"
    echo "  feature/user-authentication"
    echo "  bugfix/login-validation"
    echo "  release/v1.2.0"
    echo "  hotfix/security-patch"
    echo ""
    echo "Branch names should use lowercase and hyphens only."
    echo ""
    exit 1
fi

echo "Branch naming and push validation passed"